# Copy to .env and fill in real values locally. Never commit .env or any key file.
# Precedence: process environment > .env > application defaults.

APP_NAME=Mouth Care Solutions AI Receptionist
# development | staging | production. staging/production fail closed when anything below is missing.
APP_MODE=development
LOG_LEVEL=INFO
# 32+ random characters (signs admin sessions and per-call stream tokens).
JWT_SECRET=
# Required outside development (the admin API also places outbound calls).
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# PostgreSQL (required in staging/production; development without it keeps state in memory).
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
DATABASE_AUTO_MIGRATE=false

# Twilio Voice API ---------------------------------------------------------------------
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true
# Public HTTPS origin Twilio calls back (e.g. an ngrok domain). Origin only: no path.
PUBLIC_BASE_URL=
# Destination for controlled real-call tests. Never a customer number.
TWILIO_TEST_TO=

# Outbound policy, quota and capacity ------------------------------------------------------
# Optional fail-closed allow-list (comma-separated E.164). Empty = consent/DNC/opt-out rules only.
OUTBOUND_ALLOWED_DESTINATIONS=
OUTBOUND_RATE_LIMIT_SECONDS=300
DEFAULT_COUNTRY_CODE=91
SERVICE_QUOTA_HOURS=50
SERVICE_QUOTA_SECONDS=180000
MAX_CONCURRENT_APP_CALLS=5

# Fish Speech (the only TTS engine; keep it private - never expose it publicly) ---------------
FISH_SPEECH_ENABLED=true
FISH_SPEECH_BASE_URL=http://127.0.0.1:8080
FISH_SPEECH_API_KEY=
FISH_SPEECH_MODEL=fish-speech-1.5
FISH_SPEECH_VERSION=v1.5.1
FISH_SPEECH_REFERENCE_AUDIO=fish-references/mouth-care-receptionist-reference-20260919.wav
FISH_SPEECH_REFERENCE_TEXT=Tomorrow is holiday because of Sunday. The Sunday is because of today is Saturday. Today is Saturday is because of yesterday is Friday. Friday is because of Thursday. But I know you are not willing to listen, but you have to listen.
FISH_SPEECH_REFERENCE_ID=
# Decoder output rate reported by the server's WAV header (44100 for fish-speech-1.5).
FISH_SPEECH_SAMPLE_RATE=44100
FISH_SPEECH_CHANNELS=1
FISH_SPEECH_TIMEOUT_SECONDS=900
FISH_SPEECH_MAX_NEW_TOKENS=1024
FISH_SPEECH_VOICE_PACK_DIR=artifacts/voice-pack
FISH_SPEECH_CACHE_DIR=artifacts/tts-cache
# Live per-call synthesis for text outside the voice pack. Keep false unless the host is fast
# enough (measured CPU real-time factor on the development PC: about 14-17x).
FISH_SPEECH_LIVE_SYNTHESIS=false
FISH_SPEECH_STREAMING=false
FISH_SPEECH_LIVE_FIRST_AUDIO_BUDGET_SECONDS=4

# Optional integrations (not used by the phone path) ----------------------------------------
CLINIC_EMAIL=mouthcaresolutions@gmail.com
NOTIFICATION_PROVIDER=mock
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
VITE_API_BASE_URL=
