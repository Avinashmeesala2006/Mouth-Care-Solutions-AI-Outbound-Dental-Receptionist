  "components": {
    "schemas": {
      "AdminLoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "AdminLoginRequest"
      },
      "AgentRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AgentRequest"
      },
      "CallRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "patient_contact": {
            "type": "string",
            "maxLength": 40,
            "minLength": 5,
            "title": "Patient Contact"
          },
          "preferred_window": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Preferred Window"
          },
          "topic": {
            "type": "string",
            "maxLength": 300,
            "minLength": 2,
            "title": "Topic"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          }
        },
        "type": "object",
        "required": [
          "name",
          "patient_contact",
          "preferred_window",
          "topic",
          "consent"
        ],
        "title": "CallRequest"
      },
      "CallbackRequest": {
        "properties": {
          "patient_contact": {
            "type": "string",
            "title": "Patient Contact"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "preferred_window": {
            "type": "string",
            "title": "Preferred Window"
          }
        },
        "type": "object",
        "required": [
          "patient_contact",
          "topic",
          "preferred_window"
        ],
        "title": "CallbackRequest"
      },
      "CancelRequest": {
        "properties": {
          "booking_reference": {
            "type": "string",
            "title": "Booking Reference"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "verification": {
            "type": "string",
            "title": "Verification"
          }
        },
        "type": "object",
        "required": [
          "booking_reference",
          "reason",
          "verification"
        ],
        "title": "CancelRequest"
      },
      "ConfirmRequest": {
        "properties": {
          "hold_token": {
            "type": "string",
            "title": "Hold Token"
          },
          "patient_details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Patient Details"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "required": [
          "hold_token",
          "patient_details",
          "consent",
          "idempotency_key"
        ],
        "title": "ConfirmRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HoldRequest": {
        "properties": {
          "slot_id": {
            "type": "string",
            "title": "Slot Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "expiry_seconds": {
            "type": "integer",
            "title": "Expiry Seconds",
            "default": 300
          }
        },
        "type": "object",
        "required": [
          "slot_id",
          "session_id"
        ],
        "title": "HoldRequest"
      },
      "KnowledgeRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "locale": {
            "type": "string",
            "title": "Locale",
            "default": "en-IN"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "KnowledgeRequest"
      },
      "RescheduleRequest": {
        "properties": {
          "booking_reference": {
            "type": "string",
            "title": "Booking Reference"
          },
          "new_slot_id": {
            "type": "string",
            "title": "New Slot Id"
          },
          "verification": {
            "type": "string",
            "title": "Verification"
          }
        },
        "type": "object",
        "required": [
          "booking_reference",
          "new_slot_id",
          "verification"
        ],
        "title": "RescheduleRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
