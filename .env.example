# Copy to .env and fill in real values locally. Never commit real credentials.
# Precedence: process environment > .env > application defaults.

APP_NAME=Mouth Care Solutions AI Receptionist
# demo: MOCK_MODE=true, no real calls.  live: APP_MODE=live + MOCK_MODE=false + CALL_PROVIDER=asterisk
APP_MODE=demo
MOCK_MODE=true
CALL_PROVIDER=mock

# Telephony: open-source Asterisk (runs in WSL; set up with scripts/setup_asterisk.ps1).
ASTERISK_WSL_DISTRO=Ubuntu
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=mouthcare
# Generated by scripts/setup_asterisk.ps1; never commit it.
ASTERISK_AMI_SECRET=
ASTERISK_CONTEXT=mouthcare-receptionist
ASTERISK_AGI_BIND=127.0.0.1
ASTERISK_AGI_HOST=127.0.0.1
ASTERISK_AGI_PORT=4573
ASTERISK_RECORDING_DIR=/var/spool/asterisk/mouthcare-recordings

# The phone line. Asterisk alone cannot reach the phone network:
#   sip = a SIP/PSTN trunk from a carrier (credentials below), gsm = a GSM/4G modem + SIM (chan_dongle).
TELEPHONY_INTERFACE=
OUTBOUND_CHANNEL_TEMPLATE=
# The caller identity your carrier authorizes for this line (E.164). Never invent one.
OUTBOUND_CALLER_ID=
SIP_TRUNK_ENDPOINT=pstn-trunk
SIP_TRUNK_HOST=
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
SIP_TRUNK_REQUIRES_REGISTRATION=true
GSM_DEVICE=dongle0

# Comma-separated E.164 numbers the application may call (fail-closed allow-list).
OUTBOUND_ALLOWED_DESTINATIONS=
OUTBOUND_RATE_LIMIT_SECONDS=300
OUTBOUND_RING_TIMEOUT_SECONDS=45

# Local speech recognition for caller turns (faster-whisper model name).
ASR_MODEL=base.en

# Public HTTPS origin of the web application (optional; e.g. an ngrok domain). Origin only:
# no path. It does not provide telephone connectivity.
PUBLIC_BASE_URL=

# Durable call state (conversation turns, call records, captured requests).
CALL_STATE_DB_PATH=data/call_state.sqlite3

# Fish Speech reference voice. Calls play the verified packaged voice pack;
# the Fish server is used to (re)generate it with scripts/generate_voice_pack_http.py.
FISH_SPEECH_ENABLED=true
FISH_SPEECH_BASE_URL=http://127.0.0.1:8080
FISH_SPEECH_MODEL=fish-speech-1.5
FISH_SPEECH_REFERENCE_AUDIO=fish-references/mouth-care-receptionist-reference-20260919.wav
FISH_SPEECH_REFERENCE_TEXT=Tomorrow is holiday because of Sunday. The Sunday is because of today is Saturday. Today is Saturday is because of yesterday is Friday. Friday is because of Thursday. But I know you are not willing to listen, but you have to listen.
FISH_SPEECH_REFERENCE_ID=
FISH_SPEECH_OUTPUT_FORMAT=wav
FISH_SPEECH_SAMPLE_RATE=8000
FISH_SPEECH_CHANNELS=1
FISH_SPEECH_TIMEOUT_SECONDS=900
FISH_SPEECH_MAX_NEW_TOKENS=1024
FISH_SPEECH_AUDIO_TTL_SECONDS=300
FISH_SPEECH_VOICE_PACK_DIR=artifacts/voice-pack

# Admin API (disabled in live mode until both are set and JWT_SECRET has 32+ random characters).
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
JWT_SECRET=

# Optional integrations (not used by the phone path).
CLINIC_EMAIL=mouthcaresolutions@gmail.com
NOTIFICATION_PROVIDER=mock
PILOT_MINUTES=3000
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
FRONTEND_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=
